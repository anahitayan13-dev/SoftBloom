<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SoftBloom</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SoftBloom.MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    🌸 SoftBloom
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarMenu"
                        aria-controls="navbarMenu"
                        aria-expanded="false"
                        aria-label="Mostrar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMenu">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Inicio
                            </a>
                        </li>

                        @* Opciones del CLIENTE (usuarios con sesión que NO son Admin) *@
                        @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="PedidoCliente"
                                   asp-action="Nuevo">
                                    Hacer pedido
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="PedidoCliente"
                                   asp-action="MisPedidos">
                                    Mis pedidos
                                </a>
                            </li>
                        }

                        @* Opciones de ADMINISTRACIÓN (solo rol Admin) *@
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Categorias"
                                   asp-action="Index">
                                    Categorías
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Materiales"
                                   asp-action="Index">
                                    Materiales
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Clientes"
                                   asp-action="Index">
                                    Clientes
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Productos"
                                   asp-action="Index">
                                    Productos
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Pedidos"
                                   asp-action="Index">
                                    Pedidos
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="DetallesPedidos"
                                   asp-action="Index">
                                    Detalles de pedidos
                                </a>
                            </li>
                        }

                    </ul>

                    @* Zona de usuario: derecha del menú *@
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <span class="navbar-text me-3">
                            Bienvenido, @User.Identity.Name
                        </span>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="d-inline">

                            <button type="submit"
                                    class="btn btn-outline-danger">
                                Cerrar sesión
                            </button>

                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary me-2"
                           asp-controller="Account"
                           asp-action="Index">
                            Iniciar sesión
                        </a>

                        <a class="btn btn-primary"
                           asp-controller="Account"
                           asp-action="Register">
                            Registrarse
                        </a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container text-center">
            &copy; 2026 - SoftBloom - Sistema de Gestión de Pedidos para Tejidos
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>